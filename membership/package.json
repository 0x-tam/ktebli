{
  "name": "ktebli-membership",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint app lib scripts tests",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "catalog:import": "node --import tsx scripts/import-catalog.ts",
    "catalog:scheduled": "node --import tsx scripts/run-catalogue.ts",
    "catalog:seed-checkpoint": "node --import tsx scripts/seed-catalogue-checkpoints.ts",
    "match:run": "node --import tsx scripts/match.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/db.integration.ts",
    "test:catalogue-runner": "node --import tsx --test tests/checkpoint.integration.ts",
    "test:billing": "node --conditions=react-server --import tsx --test tests/billing.integration.ts",
    "credits:reconcile": "node --import tsx scripts/reconcile-credits.ts",
    "ops:status": "node --import tsx scripts/status.ts",
    "format": "prettier --write app lib scripts tests next.config.ts proxy.ts README.md package.json tsconfig.json",
    "format:check": "prettier --check app lib scripts tests next.config.ts proxy.ts README.md package.json tsconfig.json"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@vercel/functions": "3.9.11",
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "prettier": "3.9.9"
  },
  "type": "module"
}
