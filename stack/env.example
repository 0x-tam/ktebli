# Copy to stack/.env and fill in. Never commit stack/.env.
#
# The OpenRouter key is set HERE, by the operator, on this machine. It is deliberately
# never read out of the production project.
OPENROUTER_API_KEY=sk-or-...

# Optional. Leave unset to keep the code default, which is now the stronger generator.
# OPENROUTER_MODEL=anthropic/claude-opus-5
# OPENROUTER_MODEL_STRATEGY=

# Stripe and Resend are intentionally NOT here. Without a Resend key sendEmail returns
# false, so no mail leaves the machine; without Stripe no charge can be made. A local
# run must not be able to touch a real customer or a real card.
